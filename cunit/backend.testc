#include <config.h>

#include "cunit/unit.h"
#include "cunit/unit-service.h"

#include "imap/backend.h"

#include "imap/mutex.h"
#include "imap/saslclient.h"

#include "lib/libconfig.h"

#include <stdbool.h>

#define DBDIR   "test-backend-dbdir"

static sasl_callback_t *callbacks;

static int set_up(void)
{
    struct buf myconfig = BUF_INITIALIZER;
    char cwd[PATH_MAX], *sr;
    int r;

    sr = getcwd(cwd, sizeof(cwd));
    if (!sr) {
        fprintf(stderr, "getcwd() failed: %s\n", strerror(errno));
        return -1;
    }

    /* we need config for these tests:
     * -> certs are in current directory
     * -> disable SSL session caching
     */
    buf_printf(&myconfig, "tls_server_ca_file: %s/data/cacert.pem\n", cwd);
    buf_printf(&myconfig, "tls_server_cert: %s/data/cert.pem\n", cwd);
    buf_printf(&myconfig, "tls_server_key: %s/data/key.pem\n", cwd);
    buf_printf(&myconfig, "tls_session_timeout: 0\n");

    r = config_read_string(DBDIR"/conf", NULL, buf_cstring(&myconfig));
    buf_free(&myconfig);
    if (r) return -1;

    sasl_set_alloc(malloc, calloc, realloc, free);
    sasl_set_mutex(cyrus_mutex_alloc,
                   cyrus_mutex_lock,
                   cyrus_mutex_unlock,
                   cyrus_mutex_free);

    r = sasl_client_init((const struct sasl_callback []) {
        { SASL_CB_LIST_END, NULL, NULL },
    });
    if (r) {
        fputs("could not initialise sasl client\n", stderr);
        return -1;
    }

    /* fatal if malloc fails, wonder how badly that confuses cunit... */
    callbacks = mysasl_callbacks(CUNIT_SERVICE_USERID,
                                 CUNIT_SERVICE_USERID,
                                 NULL,
                                 CUNIT_SERVICE_PASSWORD);
    return 0;
}

static int tear_down(void)
{
    config_reset();

    if (callbacks) {
        sasl_done();
        free_callbacks(callbacks);
        callbacks = NULL;
    }

    return system("rm -rf " DBDIR);
}

/*
 * Test connecting to a host which doesn't exist.
 */
static void test_badhost(void)
{
    struct mock_service *service;
    struct protocol_t protocol;
    struct backend *be;
    const char *auth_status = NULL;

    service = cunit_service_spawn(__func__,
                                  NULL,
                                  &cunit_service_default_config,
                                  &protocol);

    be = backend_connect(NULL, "nonexistenthost", &protocol,
                         CUNIT_SERVICE_USERID, callbacks, &auth_status, -1);
    CU_ASSERT_PTR_NULL(be);
    CU_ASSERT_EQUAL(service->state.is_connected, false);

    cunit_service_destroy(&service);
}

/*
 * Test connecting to the wrong port on the right host.
 */
static void test_badservice(void)
{
    struct mock_service *service;
    struct protocol_t protocol;
    struct backend *be;
    const char *auth_status = NULL;

    service = cunit_service_spawn(__func__,
                                  NULL,
                                  &cunit_service_default_config,
                                  &protocol);

    protocol.service = "nonexistentservice";

    be = backend_connect(NULL, CUNIT_SERVICE_HOST, &protocol,
                         CUNIT_SERVICE_USERID, callbacks, &auth_status, -1);
    CU_ASSERT_PTR_NULL(be);
    CU_ASSERT_EQUAL(service->state.is_connected, false);

    cunit_service_destroy(&service);
}

